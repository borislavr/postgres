#!/usr/bin/make -f
# -*- makefile -*-

include /usr/share/dpkg/pkg-info.mk
include /usr/share/postgresql-common/pgxs.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND  = -Wall -Werror=format-security
export DEB_LDFLAGS_MAINT_APPEND = -Wl,-z,now

%:
	dh $@ --with=pgxs

override_dh_auto_configure:
	./configure \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--with-systemd \
		--with-icu \
		--with-ldap \
		--with-libxml \
		--with-lz4 \
		--with-openssl \
		--with-perl \
		--with-python \
		--with-tcl \
		--with-pam \
		CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)"

override_dh_auto_build:
	$(MAKE) -C contrib all

override_dh_auto_install:
	$(MAKE) -C contrib install DESTDIR=$(CURDIR)/debian/postgresql-16-contrib
	dh_install

override_dh_installdocs:
	dh_installdocs -XREADME.module -XREADME.*contrib*
